# إلزاميان — قاعدة Turso (خطوات الإنشاء في README)
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>

# عنوان خدمة دمج الفيديو (المنشورة حيًّا في هذا المستودع على Vercel)
MERGER_API_BASE=https://dmg1.vercel.app

# اختياري — حماية نقطة /mcp بمفتاح Bearer (إن ضُبط يُطلب على كل نداء)
MCP_ACCESS_TOKEN=

# اختياري — تجاوز أسماء الموديلات لدى المزودين إن تغيّرت
KIE_IMAGE_MODEL=
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=
